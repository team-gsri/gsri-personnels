@using System.Globalization
@using System.Reflection
@using System.Security.Cryptography
@using Gsri.Personnels.Domain
@using Gsri.Personnels.Pdf
@inject TimeProvider TimeProvider

<html>

<head>
  <style>
      body {
        margin: 0;
        padding: 30pt;
        font-family: '@DiplomeFonts.FontFamily';
        font-size: 16px;
        color: #235;
        background-image: url('data:image/jpeg;base64,@((MarkupString)ImageBackground)');
        background-size: 100%;
        background-repeat: no-repeat;
        background-position: center;
      }

      p {
        margin: 0;
      }

      .frame {
        border: 0;
        padding: 20pt;
        text-align: center;
      }

      .frame-inner {
        border: 0;
        padding: 30pt 60pt 30pt 60pt;
      }

      .title {
        font-size: 42px;
        font-weight: bold;
        margin: 0 0 0.5em 0;
        color: #833;
      }

      .pseudo {
        font-size: 42px;
        font-weight: bold;
        margin: 0.25em 0;
        border-bottom: 1pt dotted #88A;
      }

      .competence {
        font-size: 42px;
        font-weight: bold;
        margin: 0.25em 0;
        border-bottom: 1pt dotted #88A;
      }

      .dates {
        font-weight: bold;
      }

      .signature {
        margin: 1em 0 0 25em;
      }

      .logo {
        height: 127pt;
      }

      .tampon {
        height: 30pt;
      }

      table {
        margin-top: 1em;
        margin-bottom: 60pt;
        width: 100%;
      }

      td {
        width: 50%;
        vertical-align: top;
      }

      .key {
        font-size: smaller;
        color: #88A;
      }
  </style>
</head>

<body>
  <div class="frame">
    <div class="frame-inner">
      <div class="title">QUALIFICATION OPERATIONNELLE</div>
      <p class="key">@Qualification.Key.ToString().ToUpperInvariant()</p>
      <div>Le premier régiment parachutistes d'infanterie de marine certifie que</div>
      <div class="pseudo">
        @Qualification.Joueur.Pseudonyme
      </div>
      <div>a été reconnu(e) apte à assurer les fonctions de</div>
      <div class="competence">
        @Qualification.Competence.Name
      </div>
      <div>
        <img src="data:image/png;base64,@ImageTampon" class="tampon" />
        <p>du <span class="dates">@Qualification.From.ToString("D", CultureInfo)</span></p>
        <p>au <span class="dates">@Qualification.Until.ToString("D", CultureInfo)</span>.</p>
      </div>
      <table>
        <tr>
          <td>
            <p>Le candidat</p>
          </td>
          <td>
            <p>Fait le @Today.ToString("D", CultureInfo)</p>
            <p>Le chef de groupe</p>
          </td>
        </tr>
      </table>
    </div>
  </div>
</body>

</html>

@code
{
  [Parameter] public Qualification Qualification { get; set; } = null!;

  [Parameter] public CultureInfo CultureInfo { get; set; } = new("fr-FR");

  private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().Date);
  private string ImageBackground = string.Empty;
  private string ImageQualife = string.Empty;
  private string ImagePerime = string.Empty;
  private string ImageLogoMin = string.Empty;
  private string ImageLogoCos = string.Empty;
  private string ImageLogoUnite = string.Empty;
  private string ImageTampon => Qualification.IsValid(TimeProvider) ? ImageQualife : ImagePerime;

  protected override async Task OnInitializedAsync()
  {
    ImageBackground = await GetImageQualife("background.jpg");
    ImageQualife = await GetImageQualife("qualifie.png");
    ImagePerime = await GetImageQualife("perime.png");
  }

  private async Task<string> GetImageQualife(string resource)
  {
    var name = Assembly.GetExecutingAssembly().GetManifestResourceNames().Single(_ => _.EndsWith(resource));
    using var stream = Assembly.GetExecutingAssembly().GetManifestResourceStream(name)
      ?? throw new InvalidOperationException();
    using var memory = new CryptoStream(stream, new ToBase64Transform(), CryptoStreamMode.Read);
    using var reader = new StreamReader(memory);
    return await reader.ReadToEndAsync();
  }
}
