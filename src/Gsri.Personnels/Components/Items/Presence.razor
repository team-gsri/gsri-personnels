@using Gsri.Personnels.RaidHelper
@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject EventRepository EventRepository

<tr>
  <td>
    <a href="/joueurs/@Pseudonyme">
      @Pseudonyme
    </a>
  </td>
  <td>
    <a href="/operations/@When">
      @When
    </a>
  </td>
  <td>
    <div class="form-check form-switch">
      <input class="form-check-input" type="checkbox" checked="@present" id="checkNativeSwitch" @oninput="SetPresence"
             switch>
    </div>
  </td>
  <td>
    @inscrit
  </td>
</tr>

@code
{
  private bool present = false;

  private string inscrit = string.Empty;

  [Parameter] public string When { get; set; } = string.Empty;

  [Parameter] public string Pseudonyme { get; set; } = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
    present = await context.Participations
      .Where(_ => _.Joueur.Pseudonyme == Pseudonyme)
      .Where(_ => _.Operation.When == DateOnly.Parse(When))
      .AnyAsync(CancellationToken.None);

    var raidHelperId = await context.Operations
      .Where(_ => _.When == DateOnly.Parse(When))
      .FirstOrDefaultAsync(CancellationToken.None)
      is Operation operation ? operation.RaidHelperId : null;

    var discordId = await context.Joueurs
      .Where(_ => _.Pseudonyme == Pseudonyme)
      .FirstOrDefaultAsync(CancellationToken.None)
      is Joueur joueur ? joueur.DiscordId : null;

    inscrit = await EventRepository.GetInscription(raidHelperId, discordId, CancellationToken.None);
  }

  private async Task SetPresence(ChangeEventArgs args)
  {
    if (args.Value switch
    {
      true => InsertPresence,
      false => DeletePresence,
      _ => null as Func<CancellationToken, Task>
    } is not Func<CancellationToken, Task> handler) { return; }
    await handler.Invoke(CancellationToken.None);
  }

  private async Task DeletePresence(CancellationToken cancellationToken)
  {
    using var context = await DbContextFactory.CreateDbContextAsync(cancellationToken);
    await context.Participations
      .Where(_ => _.Joueur.Pseudonyme == Pseudonyme)
      .Where(_ => _.Operation.When == DateOnly.Parse(When))
      .ExecuteDeleteAsync(cancellationToken);
  }

  private async Task InsertPresence(CancellationToken cancellationToken)
  {
    using var context = await DbContextFactory.CreateDbContextAsync(cancellationToken);
    if (
      await context.Joueurs.FirstOrDefaultAsync(_ => _.Pseudonyme == Pseudonyme) is not Joueur joueur ||
      await context.Operations.FirstOrDefaultAsync(_ => _.When == DateOnly.Parse(When)) is not Operation operation)
    {
      return;
    }

    context.Participations.Add(Domain.Participation.Factory(joueur, operation));
    await context.SaveChangesAsync(cancellationToken);
  }

}