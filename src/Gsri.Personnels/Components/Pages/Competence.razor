@page "/competences/{Name}"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject TimeProvider TimeProvider

<h1>@Name</h1>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Pseudonyme</th>
      <th class="col-3">Statut</th>
      <th class="col-3">Expiration</th>
      <th class="col-3"></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var joueur in joueurs)
    {
      <tr>
        <td>
          <a href="/joueurs/@joueur.Pseudonyme">@joueur.Pseudonyme</a>
        </td>
        <td>
          @if (competence.Qualifications
            .Where(_ => _.Joueur.Pseudonyme == joueur.Pseudonyme)
            .Any(_ => _.IsValid(TimeProvider)))
          {
            <b>🎖️ Qualifié</b>
          }
          else
          {
            <i>Non</i>
          }
        </td>
        <td>
          @(competence.Qualifications
            .Where(_ => _.Joueur.Pseudonyme == joueur.Pseudonyme)
            .OrderByDescending(_ => _.Until)
            .FirstOrDefault()?.Until)
        </td>
        <td>
          <input type="button" class="btn btn-primary" value="Qualifier" @onclick="async () => await Qualifier(joueur)" />
        </td>
      </tr>
    }
  </tbody>
</table>

<h2>Historique</h2>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Date</th>
      <th class="col-3">Joueur</th>
      <th class="col-3">Expiration</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var qualification in competence.Qualifications.OrderByDescending(_ => _.Until))
    {
      <tr>
        <td>
          @qualification.From
        </td>
        <td>
          @qualification.Joueur.Pseudonyme
        </td>
        <td>
          @qualification.Until
        </td>
        <td>
          <input type="button" class="btn btn-danger" value="Supprimer"
                 @onclick="async () => await Supprimer(qualification)" />
        </td>
      </tr>
    }
  </tbody>
</table>


@code
{
  [Parameter] public string Name { get; set; } = string.Empty;

  private Domain.Competence competence = null!;
  private Domain.Joueur[] joueurs = [];

  protected override async Task OnInitializedAsync()
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();

    competence = await context.Competences.AsNoTracking()
      .Include("Qualifications.Joueur")
      .FirstAsync(_ => _.Name == Name);

    joueurs = await context.Joueurs.AsNoTracking()
      .ToArrayAsync(CancellationToken.None);
  }

  private async Task Qualifier(Domain.Joueur joueur)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    if (await context.Competences.ByName(competence.Name) is not Domain.Competence _competence
    || await context.Joueurs.ByPseudo(joueur.Pseudonyme) is not Domain.Joueur _joueur)
    {
      return;
    }

    _joueur.Qualifier(_competence, TimeProvider);
    await context.SaveChangesAsync(CancellationToken.None);
    competence = _competence;
  }

  private async Task Supprimer(Qualification qualification)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    await context.Qualifications.WhereKey(qualification.Key).ExecuteDeleteAsync();
    competence.Qualifications.Remove(qualification);
  }
}