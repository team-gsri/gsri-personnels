@page "/competences/{Name}"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject PersonnelsDbContext PersonnelsDbContext
@inject TimeProvider TimeProvider

<h1>@Name</h1>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Pseudonyme</th>
      <th class="col-3">Statut</th>
      <th class="col-3">Expiration</th>
      <th class="col-3"></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var joueur in joueurs)
    {
      <tr>
        <td>
          <a href="/joueurs/@joueur.Pseudonyme">@joueur.Pseudonyme</a>
        </td>
        <td>
          @if (@GetQualification(joueur)?.IsValid(TimeProvider) ?? false)
          {
            <b>🎖️ Qualifié</b>
          }
          else
          {
            <i>Non</i>
          }
        </td>
        <td>
          @GetQualification(joueur)?.Until
        </td>
        <td>
          <input type="button" class="btn btn-primary" value="Qualifier" @onclick="async () => await Qualifier(joueur)" />
        </td>
      </tr>
    }
  </tbody>
</table>

<h2>Historique</h2>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Date</th>
      <th class="col-6">Joueur</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var qualification in competence.Qualifications.OrderByDescending(_ => _.Until))
    {
      <tr>
        <td>
          @qualification.From
        </td>
        <td>
          @qualification.Joueur.Pseudonyme
        </td>
        <td>
          <input type="button" class="btn btn-danger" value="Supprimer"
                 @onclick="async () => await Supprimer(qualification)" />
        </td>
      </tr>
    }
  </tbody>
</table>


@code
{
  [Parameter] public string Name { get; set; } = string.Empty;

  private Domain.Competence competence = null!;
  private Domain.Joueur[] joueurs = [];

  protected override async Task OnInitializedAsync()
  {
    competence = await PersonnelsDbContext.Competences
      .Include(_ => _.Qualifications)
      .FirstAsync(_ => _.Name == Name);

    joueurs = await PersonnelsDbContext.Joueurs
      .ToArrayAsync(CancellationToken.None);
  }

  private Qualification? GetQualification(Domain.Joueur joueur) => joueur.Qualifications
    .Where(_ => _.Competence.Name == competence.Name)
    .MaxBy(_ => _.Until);

  private async Task Qualifier(Domain.Joueur joueur)
  {
    joueur.Qualifier(competence, TimeProvider);
    await PersonnelsDbContext.SaveChangesAsync(CancellationToken.None);
    StateHasChanged();
  }

  private async Task Supprimer(Qualification qualification)
  {
    PersonnelsDbContext.Qualifications.Remove(qualification);
    await PersonnelsDbContext.SaveChangesAsync(CancellationToken.None);
    StateHasChanged();
  }
}