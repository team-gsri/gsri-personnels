@page "/joueurs/{Pseudonyme}"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject PersonnelsDbContext PersonnelsDbContext
@inject TimeProvider TimeProvider

<h1>@Pseudonyme</h1>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Competence</th>
      <th class="col-3">Statut</th>
      <th class="col-3">Expiration</th>
      <th class="col-3"></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var competence in competences)
    {
      <tr>
        <td>@competence.Name</td>
        <td>
          @if (EstQualifie(competence))
          {
            <b>🎖️ Qualifié</b>
          }
          else
          {
            <i>Non</i>
          }
        </td>
        <td>
          @GetQualification(competence)?.Until
        </td>
        <td>
          <input type="button" class="btn btn-primary" value="Qualifier"
                 @onclick="async () => await Qualifier(competence)" />
        </td>
      </tr>
    }
  </tbody>
</table>

<h2>Historique</h2>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Date</th>
      <th class="col-6">Compétence</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var qualification in joueur.Qualifications.OrderByDescending(_ => _.Until))
    {
      <tr>
        <td>
          @qualification.From
        </td>
        <td>
          @qualification.Competence.Name
        </td>
        <td>
          <input type="button" class="btn btn-danger" value="Supprimer"
                 @onclick="async () => await Supprimer(qualification)" />
        </td>
      </tr>
    }
  </tbody>
</table>


@code
{
  [Parameter] public string Pseudonyme { get; set; } = string.Empty;

  private Domain.Joueur joueur = null!;
  private Domain.Competence[] competences = [];

  protected override async Task OnInitializedAsync()
  {
    competences = await PersonnelsDbContext.Competences
      .ToArrayAsync(CancellationToken.None);

    joueur = await PersonnelsDbContext.Joueurs
      .Include("Qualifications.Competence")
      .FirstAsync(_ => _.Pseudonyme == Pseudonyme);
  }

  private Qualification? GetQualification(Competence competence) => joueur.Qualifications
    .Where(_ => _.Competence.Name == competence.Name)
    .MaxBy(_ => _.Until);

  private bool EstQualifie(Competence competence) => GetQualification(competence)?.IsValid(TimeProvider) ?? false;

  private async Task Qualifier(Competence competence)
  {
    joueur.Qualifier(competence, TimeProvider);
    await PersonnelsDbContext.SaveChangesAsync(CancellationToken.None);
    StateHasChanged();
  }

  private async Task Supprimer(Qualification qualification)
  {
    joueur.Qualifications.Remove(qualification);
    await PersonnelsDbContext.SaveChangesAsync(CancellationToken.None);
    StateHasChanged();
  }
}