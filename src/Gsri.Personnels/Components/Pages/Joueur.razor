@page "/joueurs/{Pseudonyme}"
@using Gsri.Personnels.Components.Items
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject TimeProvider TimeProvider

<h1>@Pseudonyme</h1>

<form class="row g-2 mb-3" @onsubmit="ModifierDiscordId">
  <div class="col-auto">
    <label class="col-form-label" for="discord-id">Discord ID</label>
  </div>
  <div class="col-auto">
    <input id="discord-id" type="text" inputmode="numeric" class="form-control" @bind-value="discord_id" />
  </div>
  <div class="col-auto">
    <input type="submit" class="btn btn-primary" value="Enregistrer" />
  </div>
  @if (discord_id_error is not null)
  {
    <div class="col-auto">
      <span class="form-text text-danger">@discord_id_error</span>
    </div>
  }
</form>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Competence</th>
      <th class="col-3">Statut</th>
      <th class="col-3">Expiration</th>
      <th class="col-3"></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var competence in competences)
    {
      <tr>
        <td>
          <a href="/competences/@competence.Name">
            @competence.Name
          </a>
        </td>
        <td>
          @if (joueur.Qualifications
            .Where(_ => _.Competence.Name == competence.Name)
            .Any(_ => _.IsValid(TimeProvider)))

          {
            <b>🎖️ Qualifié</b>
          }
          else
          {
            <i>Non</i>
          }
        </td>
        <td>
          @(joueur.Qualifications
            .Where(_ => _.Competence.Name == competence.Name)
            .OrderByDescending(_ => _.Until)
            .FirstOrDefault()?.Until)
        </td>
        <td>
          <input type="button" class="btn btn-primary" value="Qualifier"
                 @onclick="async () => await Qualifier(competence)" />
        </td>
      </tr>
    }
  </tbody>
</table>

<h2>Qualifications</h2>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Date</th>
      <th class="col-3">Compétence</th>
      <th class="col-3">Expiration</th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var qualification in joueur.Qualifications.OrderByDescending(_ => _.Until))
    {
      <tr>
        <td>
          @qualification.From
        </td>
        <td>
          @qualification.Competence.Name
        </td>
        <td>
          @qualification.Until
        </td>
        <td>
          <a class="btn btn-outline-primary" href="/qualifications/@qualification.Key/diplome.pdf" target="_blank">
            🎓 Diplôme
          </a>
        </td>
        <td>
          <input type="button" class="btn btn-danger" value="Supprimer"
                 @onclick="async () => await Supprimer(qualification)" />
        </td>
      </tr>
    }
  </tbody>
</table>

<h2>Présences</h2>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Joueur</th>
      <th class="col-3">Opération</th>
      <th class="col-3">Présence</th>
      <th class="col-3">Inscrit</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var operation in operations.OrderByDescending(_ => _.When))
    {
      <Presence Pseudonyme="@Pseudonyme" When="@operation.When.ToString("yyyy-MM-dd")" />
    }
  </tbody>
</table>

@code
{
  [Parameter] public string Pseudonyme { get; set; } = string.Empty;

  private Domain.Joueur joueur = null!;
  private Domain.Competence[] competences = [];
  private Domain.Operation[] operations = [];
  private string? discord_id;
  private string? discord_id_error;

  protected override async Task OnInitializedAsync()
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();

    joueur = await context.Joueurs.AsNoTracking()
      .Include("Qualifications.Competence")
      .FirstAsync(_ => _.Pseudonyme == Pseudonyme);

    discord_id = joueur.DiscordId?.Value.ToString();

    competences = await context.Competences.AsNoTracking()
      .ToArrayAsync(CancellationToken.None);

    operations = await context.Operations.AsNoTracking()
      .ToArrayAsync(CancellationToken.None);
  }

  private async Task Qualifier(Domain.Competence competence)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    if (await context.Competences.ByName(competence.Name) is not Domain.Competence _competence
    || await context.Joueurs.ByPseudo(joueur.Pseudonyme) is not Domain.Joueur _joueur)
    {
      return;
    }

    _joueur.Qualifier(_competence, TimeProvider);
    await context.SaveChangesAsync(CancellationToken.None);
    joueur = _joueur;
  }

  private async Task ModifierDiscordId()
  {
    Domain.DiscordId? value = null;
    if (!string.IsNullOrWhiteSpace(discord_id) && !Domain.DiscordId.TryParse(discord_id.Trim(), out value))
    {
      discord_id_error = "Discord ID invalide";
      return;
    }

    await using var context = await DbContextFactory.CreateDbContextAsync();
    if (await context.Joueurs.ByPseudo(joueur.Pseudonyme) is not Domain.Joueur _joueur)
    {
      return;
    }

    _joueur.DiscordId = value;
    await context.SaveChangesAsync(CancellationToken.None);
    joueur.DiscordId = value;
    discord_id_error = null;
  }

  private async Task Supprimer(Domain.Qualification qualification)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    await context.Qualifications.Where(_ => _.Key == qualification.Key).ExecuteDeleteAsync();
    joueur.Qualifications.Remove(qualification);
    StateHasChanged();
  }
}