@page "/joueurs/{Pseudonyme}"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject TimeProvider TimeProvider

<h1>@Pseudonyme</h1>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Competence</th>
      <th class="col-3">Statut</th>
      <th class="col-3">Expiration</th>
      <th class="col-3"></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var competence in competences)
    {
      <tr>
        <td>
          <a href="/competences/@competence.Name">
            @competence.Name
          </a>
        </td>
        <td>
          @if (joueur.Qualifications
            .Where(_ => _.Competence.Name == competence.Name)
            .Any(_ => _.IsValid(TimeProvider)))

          {
            <b>🎖️ Qualifié</b>
          }
          else
          {
            <i>Non</i>
          }
        </td>
        <td>
          @(joueur.Qualifications
            .Where(_ => _.Competence.Name == competence.Name)
            .OrderByDescending(_ => _.Until)
            .FirstOrDefault()?.Until)
        </td>
        <td>
          <input type="button" class="btn btn-primary" value="Qualifier"
                 @onclick="async () => await Qualifier(competence)" />
        </td>
      </tr>
    }
  </tbody>
</table>

<h2>Historique</h2>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Date</th>
      <th class="col-3">Compétence</th>
      <th class="col-3">Expiration</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var qualification in joueur.Qualifications.OrderByDescending(_ => _.Until))
    {
      <tr>
        <td>
          @qualification.From
        </td>
        <td>
          @qualification.Competence.Name
        </td>
        <td>
          @qualification.Until
        </td>
        <td>
          <input type="button" class="btn btn-danger" value="Supprimer"
                 @onclick="async () => await Supprimer(qualification)" />
        </td>
      </tr>
    }
  </tbody>
</table>


@code
{
  [Parameter] public string Pseudonyme { get; set; } = string.Empty;

  private Domain.Joueur joueur = null!;
  private Domain.Competence[] competences = [];

  protected override async Task OnInitializedAsync()
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();

    joueur = await context.Joueurs.AsNoTracking()
      .Include("Qualifications.Competence")
      .FirstAsync(_ => _.Pseudonyme == Pseudonyme);

    competences = await context.Competences.AsNoTracking()
      .ToArrayAsync(CancellationToken.None);
  }

  private async Task Qualifier(Domain.Competence competence)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    if (await context.Competences.ByName(competence.Name) is not Domain.Competence _competence
    || await context.Joueurs.ByPseudo(joueur.Pseudonyme) is not Domain.Joueur _joueur)
    {
      return;
    }

    _joueur.Qualifier(_competence, TimeProvider);
    await context.SaveChangesAsync(CancellationToken.None);
    joueur = _joueur;
  }

  private async Task Supprimer(Domain.Qualification qualification)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    await context.Qualifications.Where(_ => _.Key == qualification.Key).ExecuteDeleteAsync();
    joueur.Qualifications.Remove(qualification);
    StateHasChanged();
  }
}