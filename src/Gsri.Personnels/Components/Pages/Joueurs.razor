@page "/joueurs"
@using Gsri.Personnels.Components.Items
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@rendermode InteractiveServer
@attribute [Authorize]

@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject ILogger<Competences> Logger

<h1>Joueurs</h1>

<table class="table">
  <thead>
    <tr>
      <th class="col-3">Pseudonyme</th>
      <th class="col-3"></th>
      <th class="col-3">Dernière présence</th>
      <th class="col-3"></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var joueur in joueurs.OrderBy(_ => _.Pseudonyme))
    {
      <Participation Pseudonyme="@joueur.Pseudonyme" OnListChanged="OnListChanged" />
    }
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3">
        <input type="text" class="form-control" @bind-value="add_name" />
      </td>
      <td>
        <input type="button" class="btn btn-primary" value="Ajouter" @onclick="Ajouter" />
      </td>
    </tr>
  </tfoot>
</table>

@code
{
  private Domain.Joueur[] joueurs = [];
  private string add_name = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    joueurs = await context.Joueurs.AsNoTracking()
      .Include("Participations.Operation")
      .ToArrayAsync(CancellationToken.None);
  }

  private async Task Ajouter(MouseEventArgs args)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    var joueur = context.Joueurs.Add(Domain.Joueur.Factory(add_name)).Entity;
    await context.SaveChangesAsync(CancellationToken.None);
    joueurs = [.. joueurs, joueur];
  }

  private async Task OnListChanged() => await OnInitializedAsync();
}