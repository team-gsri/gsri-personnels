@page "/joueurs"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject ILogger<Competences> Logger

<h1>Compétences</h1>

<table class="table">
  <thead>
    <tr>
      <th class="col-9">Pseudonyme</th>
      <th class="col-3"></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var joueur in joueurs.OrderBy(_ => _.Pseudonyme))
    {
      <tr>
        <td>
          <a href="./joueurs/@joueur.Pseudonyme">
            @joueur.Pseudonyme
          </a>
        </td>
        <td>
          <input type="button" class="btn btn-danger" value="Supprimer" @onclick="async () => await Supprimer(joueur)" />
        </td>
      </tr>
    }
  </tbody>
  <tfoot>
    <tr>
      <td>
        <input type="text" class="form-control" @bind-value="add_name" />
      </td>
      <td>
        <input type="button" class="btn btn-primary" value="Ajouter" @onclick="Ajouter" />
      </td>
    </tr>
  </tfoot>
</table>

@code
{
  private Domain.Joueur[] joueurs = [];
  private string add_name = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    joueurs = await context.Joueurs.AsNoTracking().ToArrayAsync(CancellationToken.None);
  }

  private async Task Ajouter(MouseEventArgs args)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    var joueur = context.Joueurs.Add(Domain.Joueur.Factory(add_name)).Entity;
    await context.SaveChangesAsync(CancellationToken.None);
    joueurs = [.. joueurs, joueur];
  }

  private async Task Supprimer(Domain.Joueur joueur)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    await context.Joueurs.WherePseudo(joueur.Pseudonyme).ExecuteDeleteAsync();
    joueurs = joueurs.Except([joueur]).ToArray();
  }
}