@page "/competences"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject ILogger<Competences> Logger

<h1>Compétences</h1>

<form>
  <table class="table">
    <thead>
      <tr>
        <th class="col-6">Nom</th>
        <th class="col-3">Durée (en jours)</th>
        <th class="col-3"></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var competence in competences.OrderBy(_ => _.Name))
      {
        <tr>
          <td>
            <a href="./competences/@competence.Name">
              @competence.Name
            </a>
          </td>
          <td>
            @competence.Duree
          </td>
          <td>
            <input type="button" class="btn btn-danger" value="Supprimer"
                   @onclick="async () => await Supprimer(competence)" />
          </td>
        </tr>
      }
    </tbody>
    <tfoot>
      <tr>
        <td>
          <input type="text" class="form-control" @bind-value="add_name" @ref="add_name_ref" />
        </td>
        <td>
          <input type="number" class="form-control" @bind-value="add_duree" />
        </td>
        <td>
          <input type="button" class="btn btn-primary" value="Ajouter" @onclick="Ajouter" />
        </td>
      </tr>
    </tfoot>
  </table>
</form>

@code
{
  private Domain.Competence[] competences = [];
  private int add_duree = 90;
  private string add_name = string.Empty;
  private ElementReference add_name_ref;

  protected override async Task OnInitializedAsync()
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    competences = await context.Competences.AsNoTracking().ToArrayAsync(CancellationToken.None);
  }

  private async Task Ajouter(MouseEventArgs args)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    var competence = context.Competences.Add(Domain.Competence.Factory(add_name, add_duree)).Entity;
    await context.SaveChangesAsync(CancellationToken.None);
    competences = [.. competences, competence];
    add_name = string.Empty;
    await add_name_ref.FocusAsync(preventScroll: false);
  }

  private async Task Supprimer(Domain.Competence competence)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    await context.Competences.WhereName(competence.Name).ExecuteDeleteAsync(CancellationToken.None);
    competences = competences.Except([competence]).ToArray();
  }
}