@page "/operations"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using Bit.BlazorUI

@rendermode InteractiveServer
@attribute [Authorize]

@inject NavigationManager NavigationManager
@inject IDbContextFactory<PersonnelsDbContext> DbContextFactory
@inject ILogger<Competences> Logger
@inject TimeProvider TimeProvider

<h1>Opérations</h1>
<div class="container">
  
  <div class="input-group mb-3">
    <InputDate TValue="DateOnly" @bind-Value="add_when" class="form-control" />
    <input type="button" class="btn btn-primary" value="Ajouter" @onclick="Ajouter" />
  </div>

  <div class="btn-group mb-3 w-100" role="group">
    <BitButton Variant="BitVariant.Fill" class="btn" OnClick="() => calendar?.NavigatePrevious()">
      Précédent
    </BitButton>
    <BitButton Variant="BitVariant.Outline" class="btn" OnClick="() => calendar?.GoToToday()">
      Aujourd'hui
    </BitButton>
    <BitButton Variant="BitVariant.Fill" class="btn" OnClick="() => calendar?.NavigateNext()">
      Suivant
    </BitButton>
  </div>

  <BitFullCalendar @ref="calendar" Events="events" ReadOnly=true CultureName="fr-FR" HideHeader=true
                   OnEventClick="OnEventClick" Class="mb-3" />

</div>

@code
{
  private CultureInfo cultureInfo = new("fr-FR");
  private Domain.Operation[] operations = [];
  private DateOnly add_when = DateOnly.MinValue;
  private BitFullCalendar? calendar;
  public List<BitFullCalendarEvent> events { get; private set; } = [];

  protected override async Task OnInitializedAsync()
  {
    add_when = DateOnly.FromDateTime(TimeProvider.GetLocalNow().Date);
    await using var context = await DbContextFactory.CreateDbContextAsync();
    operations = await context.Operations.AsNoTracking()
      .Include(_ => _.Participations)
      .ToArrayAsync(CancellationToken.None);

    events = await context.Operations.AsNoTracking().Select(
      _ => new BitFullCalendarEvent()
      {
        Id = _.When.ToString("yyyy-MM-dd"),
        Title = $"Participants : {_.Participations.Count}",
        IsAllDay = true,
        StartDate = _.When.ToDateTime(new TimeOnly(21, 0)),
      }).ToListAsync(CancellationToken.None);
  }

  private async Task Ajouter(MouseEventArgs args)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    var operation = context.Operations.Add(Domain.Operation.Factory(add_when)).Entity;
    await context.SaveChangesAsync(CancellationToken.None);
    operations = [.. operations, operation];
  }

  private async Task Supprimer(Domain.Operation operation)
  {
    await using var context = await DbContextFactory.CreateDbContextAsync();
    await context.Operations.WhereWhen(operation.When).ExecuteDeleteAsync();
    operations = operations.Except([operation]).ToArray();
  }

  private void OnEventClick(BitFullCalendarEvent bitFullCalendarEvent)
  {
    NavigationManager.NavigateTo($"/operations/{bitFullCalendarEvent.Id}");
  }
}